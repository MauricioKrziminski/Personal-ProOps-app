{
  "expo": {
    "name": "ProOps",
    "slug": "app-ProOps",
    "version": "1.12.0",
    "orientation": "portrait",
    "icon": "./assets/images/icons/icon-512.png",
    "scheme": "appproops",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#0B0B0C",
    "ios": {
      "bundleIdentifier": "com.proops.personal",
      "appleTeamId": "7FKQLD9MCJ",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIViewControllerBasedStatusBarAppearance": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1",
              "1C8F.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/brand/android-foreground.png",
        "monochromeImage": "./assets/images/brand/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.proops.personal"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icons/icon-192.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0C",
          "image": "./assets/images/brand/splash-vazio.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#0B0B0C",
            "image": "./assets/images/brand/splash-vazio.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite abrir o $(PRODUCT_NAME) com o Face ID."
        }
      ],
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": "Permita que o ProOps use o microfone para enviar áudio ao agente.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permita que o ProOps use o microfone para enviar áudio ao agente.",
          "speechRecognitionPermission": "Permita que o ProOps transcreva o que você fala enquanto grava para o agente.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "./plugins/with-android-abis",
      "./plugins/with-text-advance-width",
      "./plugins/with-android-theme-colors",
      "./plugins/with-work-runtime-alinhado"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8313579c-3979-4ecd-ba6a-4dc0bf702f05"
      }
    },
    "owner": "solutions.proops",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8313579c-3979-4ecd-ba6a-4dc0bf702f05"
    }
  }
}
