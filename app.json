{
  "expo": {
    "name": "Personal ProOps app",
    "slug": "app-ProOps",
    "version": "1.3.35",
    "orientation": "portrait",
    "icon": "./assets/images/icons/icon-512.png",
    "scheme": "appproops",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.proops.personal",
      "supportsTablet": true,
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/brand/android-foreground.png",
        "monochromeImage": "./assets/images/brand/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.proops.personal"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icons/icon-192.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0C",
          "image": "./assets/images/brand/mark-white.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#0B0B0C",
            "image": "./assets/images/brand/mark-white.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite abrir o $(PRODUCT_NAME) com o Face ID."
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "./plugins/with-android-abis",
      "./plugins/with-apk-installer",
      "./plugins/with-text-advance-width"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8313579c-3979-4ecd-ba6a-4dc0bf702f05"
      }
    },
    "owner": "solutions.proops",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8313579c-3979-4ecd-ba6a-4dc0bf702f05"
    }
  }
}
