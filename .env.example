# App Expo — apenas chaves públicas (anon). Copie para .env e preencha.
# Segredos de servidor (Gemini, Groq, WhatsApp) ficam em supabase/.env.example.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# URL do agente Python (Cloud Run). A aba Agente fala com ele, não com o Postgres:
# as tabelas de conversa são infraestrutura, sem policy e sem grant para o app.
# Vazio = a aba avisa que não está configurada, em vez de falhar em runtime.
EXPO_PUBLIC_AGENT_URL=

# RevenueCat (compras pela loja) — chaves PÚBLICAS do SDK, uma por plataforma. Vazio = o app diz
# "Assinatura indisponível no momento" e não mostra preço. Precisa de development build (módulo nativo).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Loja de teste da RevenueCat (chave `test_...`): compra simulada, sem conta Apple/Google. Só vale em
# `__DEV__` (dev client) e vence as chaves acima; em release é ignorada (o SDK fecha o app com ela).
# NUNCA em build de loja/EAS. O webhook chega como sandbox: o agente de staging precisa de BILLING_ALLOW_SANDBOX=true.
EXPO_PUBLIC_REVENUECAT_TEST_KEY=
