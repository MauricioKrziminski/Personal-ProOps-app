# Segredos do serviço Python. Em produção vêm do GCP Secret Manager
# (gcloud run deploy --set-secrets), nunca de arquivo no container.
# NUNCA commitar o .env real.
#
# ┌─ [BOOT]     sem isto o container NÃO SOBE (app/main.py recusa)
# ├─ [1ª MSG]   sobe, mas a primeira mensagem falha
# └─ [DEGRADA]  vazio só desliga aquele recurso
#
# GCP_PROJECT, GCP_LOCATION, TASKS_QUEUE, TASKS_SA_EMAIL, WORKER_URL e
# OIDC_AUDIENCE são preenchidas pelo ./scripts/setup-gcp.sh — não precisa
# adivinhar a URL do Cloud Run antes de ele existir.

# --- Postgres do Supabase --------------------------------------------------
# Use o SESSION pooler (porta 5432), não o transaction pooler (6543): o
# checkpointer do LangGraph usa prepared statements, que o modo transaction
# derruba. Se só houver o transaction pooler, ver DB_PREPARE_THRESHOLD abaixo.
# [BOOT]
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DB_PREPARE_THRESHOLD=          # deixe vazio no session pooler; use 0 no transaction pooler

# --- Meta WhatsApp Cloud API ------------------------------------------------
WHATSAPP_TOKEN=                # [1ª MSG] token permanente do system user
WHATSAPP_PHONE_NUMBER_ID=      # [1ª MSG]
WHATSAPP_APP_SECRET=           # [1ª MSG] valida o X-Hub-Signature-256 — sem ele TODO webhook é 401
WHATSAPP_VERIFY_TOKEN=         # [1ª MSG] string sua, usada no GET de verificação da Meta
WA_OTP_TEMPLATE=personal_proops_login_otp
WA_REMINDER_TEMPLATE=personal_proops_reminder

# --- IA ---------------------------------------------------------------------
GEMINI_API_KEY=                # [1ª MSG]
GROQ_API_KEY=                  # [DEGRADA] sem ele, áudio não é transcrito (texto segue normal)

# --- Google Cloud Tasks (debounce) ------------------------------------------
GCP_PROJECT=
GCP_LOCATION=southamerica-east1
TASKS_QUEUE=wa-debounce
WORKER_URL=                    # https://<cloud-run>/worker/process-thread
TASKS_SA_EMAIL=                # service account que assina o token OIDC
DEBOUNCE_SECONDS=3
DEBOUNCE_BACKEND=cloud_tasks   # 'inline' no dev local (chama o worker direto)

# --- Segurança --------------------------------------------------------------
THREAD_SALT=                   # [BOOT] aleatório, 32+ bytes: openssl rand -hex 32
                               # trocar reescreve todo thread_id (e órfã confirmações pendentes)
OIDC_AUDIENCE=                 # a URL do serviço no Cloud Run
INTERNAL_SECRET=               # [BOOT, se não houver OIDC] fallback p/ VPS (header X-Internal-Secret)
SEND_SMS_HOOK_SECRET=          # [DEGRADA] sem ele /hooks/otp devolve 500 e o login por WhatsApp para
REVENUECAT_WEBHOOK_SECRET=     # [DEGRADA] sem ele /hooks/billing devolve 500 e plano pago não é concedido
BILLING_ALLOW_SANDBOX=         # 'true' SÓ durante os testes de sandbox. TEM que sair antes de publicar.
SUPABASE_URL=                  # [DEGRADA] https://<ref>.supabase.co — dela sai o JWKS (ES256)
                               # que valida o JWT do app. Sem ela, a importação de extrato dá 401.

# --- Regras de negócio ------------------------------------------------------
HITL_AMOUNT_THRESHOLD_CENTS=100000   # R$ 1.000 — acima disso, pede confirmação
MAX_PARSES_PER_HOUR=60
PENDING_TTL_MINUTES=10
SESSION_IDLE_HOURS=6

# --- Langfuse ---------------------------------------------------------------
# [DEGRADA] sem as duas chaves o grafo roda igual, só sem tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
