# Cloud Run uploads only the inputs used by this Dockerfile.
# Keep development environments, credentials, tests and caches out of the source archive.
**
!.gcloudignore
!.dockerignore
!Dockerfile
!requirements.txt
!app/
!app/**
**/__pycache__/
**/*.pyc
**/.env
**/.env.*
!admin-web/
!admin-web/**
admin-web/node_modules/
admin-web/dist/
app/static/admin/
# testes do painel (Playwright): capturas, traces e relatórios ficam no Mac — nada disso entra na imagem
admin-web/e2e/
admin-web/test-results/
admin-web/playwright-report/
admin-web/playwright.config.*
