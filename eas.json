{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_VARIANT": "development",
        "DISTRIBUICAO": "apk"
      },
      "ios": {
        "simulator": false
      },
      "channel": "development",
      "autoIncrement": true
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "preview",
        "DISTRIBUICAO": "apk"
      },
      "channel": "preview",
      "autoIncrement": true
    },
    "staging": {
      "extends": "preview",
      "channel": "staging",
      "android": {
        "buildType": "apk"
      }
    },
    "distribution": {
      "distribution": "internal",
      "environment": "production",
      "env": {
        "APP_VARIANT": "production",
        "DISTRIBUICAO": "apk"
      },
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "APP_VARIANT": "production",
        "DISTRIBUICAO": "loja"
      },
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "PREENCHER_ASC_APP_ID",
        "appleTeamId": "7FKQLD9MCJ"
      },
      "android": {
        "serviceAccountKeyPath": "./secrets/google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
