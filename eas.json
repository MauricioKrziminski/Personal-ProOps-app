{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": { "APP_VARIANT": "development" },
      "ios": {
        "simulator": false
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": { "APP_VARIANT": "preview" },
      "channel": "preview"
    },
    "staging": {
      "extends": "preview",
      "channel": "staging",
      "android": {
        "buildType": "apk"
      }
    },
    "distribution": {
      "distribution": "internal",
      "environment": "production",
      "env": { "APP_VARIANT": "production" },
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "env": { "APP_VARIANT": "production" },
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
